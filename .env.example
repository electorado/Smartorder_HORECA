# Base de Datos local con Docker
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=supplypassword
MONGO_HOST=localhost
MONGO_PORT=27017

# Opcional: MongoDB Atlas (Nube)
# Si se define MONGO_URI, se ignora la configuración local de Docker
# MONGO_URI=mongodb+srv://<usuario>:<password>@cluster0.mongodb.net/fb_smartorder?retryWrites=true&w=majority

# API Key gratuita de Google AI Studio para visión multimodal (Gemini 1.5 Flash)
# GEMINI_API_KEY=tu_api_key_aqui
