<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@drawable/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FBSmartOrder"
        tools:ignore="IconLocation"
        tools:targetApi="31">

        <!-- Pantalla de Bienvenida / Landing & Menú Principal -->
        <activity
            android:name=".LandingActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla de Selección de Catálogo y Pedido -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Historial de Pedidos -->
        <activity
            android:name=".OrderHistoryActivity"
            android:exported="false" />

        <!-- Directorio y Gestión de Proveedores -->
        <activity
            android:name=".SuppliersActivity"
            android:exported="false" />

    </application>

</manifest>
