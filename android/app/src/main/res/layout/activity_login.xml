<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Sello de Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_stamp_header"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:fontFamily="@font/retro_condensed_italic"
                app:fontFamily="@font/retro_condensed_italic"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:text="F&amp;B SMARTORDER"
                android:textColor="@color/bg_paper"
                android:textSize="40sp"
                android:autoSizeTextType="uniform"
                app:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="24sp"
                app:autoSizeMinTextSize="24sp"
                android:autoSizeMaxTextSize="44sp"
                app:autoSizeMaxTextSize="44sp"
                android:autoSizeStepGranularity="1sp"
                app:autoSizeStepGranularity="1sp" />
        </LinearLayout>

        <!-- Tarjeta de Login -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_search_dashed"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:text="INICIAR SESIÓN"
                android:textColor="@color/stamp_red_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-condensed"
                android:text="Introduce tus credenciales de cocinero"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Campo Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-condensed"
                android:text="Correo Electrónico / Usuario:"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etLoginEmail"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_search_input"
                android:fontFamily="sans-serif-condensed"
                android:hint="cuisto@horeca.com"
                android:inputType="textEmailAddress"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <!-- Campo Contraseña -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-condensed"
                android:text="Contraseña:"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etLoginPassword"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_search_input"
                android:fontFamily="sans-serif-condensed"
                android:hint="••••••••"
                android:inputType="textPassword"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <!-- Pista de acceso demo -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-condensed"
                android:text="Demo rápida: cuisto@horeca.com / password123"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <!-- ¿Has olvidado la contraseña? -->
            <TextView
                android:id="@+id/btnForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="6dp"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="sans-serif-condensed"
                android:padding="4dp"
                android:text="¿Has olvidado la contraseña?"
                android:textColor="@color/stamp_red_dark"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Barra de Progreso -->
            <ProgressBar
                android:id="@+id/pbLoginLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

            <!-- Botón Iniciar Sesión -->
            <Button
                android:id="@+id/btnLoginEnter"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/stamp_red"
                android:fontFamily="sans-serif-condensed"
                android:text="ENTRAR A COCINA"
                android:textColor="@color/bg_paper"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Enlace a Registro -->
            <Button
                android:id="@+id/btnGoToRegister"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-condensed"
                android:text="¿No tienes cuenta? Regístrate aquí"
                android:textColor="@color/stamp_red_dark"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
