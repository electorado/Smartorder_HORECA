<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_paper"
    tools:context=".MainActivity">

    <!-- Cabecera / Sello Vintage Rojo -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_stamp_header"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvBrand"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:fontFamily="@font/retro_condensed_italic"
            app:fontFamily="@font/retro_condensed_italic"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:text="@string/header_brand"
            android:textColor="@color/bg_paper"
            android:textSize="40sp"
            android:autoSizeTextType="uniform"
            app:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="24sp"
            app:autoSizeMinTextSize="24sp"
            android:autoSizeMaxTextSize="44sp"
            app:autoSizeMaxTextSize="44sp"
            android:autoSizeStepGranularity="1sp"
            app:autoSizeStepGranularity="1sp" />
    </LinearLayout>

    <!-- Barra de Título de Sección -->
    <LinearLayout
        android:id="@+id/layoutSectionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutHeader">

        <TextView
            android:id="@+id/tvSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:text="COMANDA ACTUAL"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Banner de Advertencia de Conexión / Error Backend -->
    <LinearLayout
        android:id="@+id/layoutConnectionWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:background="#FDE8E8"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutSectionBar">

        <TextView
            android:id="@+id/tvConnectionWarningText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-condensed"
            android:text="⚠️ Sin conexión con backend FastAPI (puerto 8000)"
            android:textColor="@color/stamp_red_dark"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnRetryConnection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-condensed"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="Reintentar 🔄"
            android:textColor="@color/stamp_red"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ============================================================== -->
    <!-- 1. VISTA: MI PEDIDO / COMANDA ACTUAL                            -->
    <!-- ============================================================== -->
    <LinearLayout
        android:id="@+id/layoutOrderView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@+id/layoutBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutConnectionWarning">

        <!-- ESTADO VACÍO (Si la comanda no tiene productos) -->
        <LinearLayout
            android:id="@+id/layoutEmptyOrder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:src="@drawable/ic_empty_clipboard"
                android:contentDescription="Comanda vacía" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-condensed"
                android:text="COMANDA VACÍA"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:text="No tienes ningún producto en la comanda.\nFotografía tu lista de la nevera o añade productos desde el catálogo."
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnEmptyScanCamera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="24dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:backgroundTint="@color/stamp_red"
                android:fontFamily="sans-serif-condensed"
                android:text="Escanear Lista de Nevera / Pizarra"
                app:icon="@drawable/ic_camera"
                app:iconGravity="textStart"
                app:iconTint="@color/bg_paper"
                android:textColor="@color/bg_paper"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnEmptyOpenCatalog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:backgroundTint="@color/button_retro_bg"
                android:fontFamily="sans-serif-condensed"
                android:text="Añadir Productos desde el Catálogo"
                app:icon="@drawable/ic_notebook"
                app:iconGravity="textStart"
                app:iconTint="@color/bg_paper"
                android:textColor="@color/bg_paper"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnEmptyAddNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:backgroundTint="@color/button_retro_bg"
                android:fontFamily="sans-serif-condensed"
                android:text="NOTA U OBSERVACIÓN PARA PROVEEDOR"
                app:icon="@drawable/ic_note"
                app:iconGravity="textStart"
                app:iconTint="@color/bg_paper"
                android:textColor="@color/bg_paper"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ESTADO ACTIVO (Si la comanda tiene productos) -->
        <LinearLayout
            android:id="@+id/layoutActiveOrder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Botón para añadir nota u observaciones fuera de catálogo -->
            <Button
                android:id="@+id/btnAddActiveOffCatalog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="42dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="4dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:backgroundTint="@color/button_retro_bg"
                android:fontFamily="sans-serif-condensed"
                android:text="+ Añadir Nota o Ítem fuera de catálogo"
                app:icon="@drawable/ic_note"
                app:iconGravity="textStart"
                app:iconTint="@color/bg_paper"
                android:textColor="@color/bg_paper"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Lista de Líneas de Pedido -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOrderLines"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                tools:listitem="@layout/item_order_line" />

            <!-- Bloque Inferior del Ticket: Notas, Total y Botón Enviar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#EDE4D3"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <!-- Campo de Notas para el Proveedor -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:text="📝 Notas proveedor:"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etOrderNotes"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_search_dashed"
                        android:fontFamily="sans-serif-condensed"
                        android:hint="Ej. Entrega mañana antes de las 10:00h"
                        android:maxLines="2"
                        android:paddingStart="8dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="4dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Resumen de Totales -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvOrderSummaryCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-condensed"
                        android:text="6 productos seleccionados"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvOrderSummaryTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:text="Total: 84,35 €"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Botón Principal: Enviar Pedido por WhatsApp -->
                <LinearLayout
                    android:id="@+id/btnSubmitOrder"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_btn_retro"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="12dp">

                    <View
                        android:layout_width="5dp"
                        android:layout_height="28dp"
                        android:background="@color/button_accent_orange" />

                    <TextView
                        android:id="@+id/tvButtonText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.05"
                        android:text="ENVIAR POR WHATSAPP 📲"
                        android:textColor="@color/bg_paper"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBadgeOk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_ok"
                        android:fontFamily="sans-serif-condensed"
                        android:paddingStart="6dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="2dp"
                        android:text="@string/ok_badge"
                        android:textColor="@color/button_retro_bg"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ============================================================== -->
    <!-- 2. VISTA: CATÁLOGO DE PRODUCTOS                                 -->
    <!-- ============================================================== -->
    <LinearLayout
        android:id="@+id/layoutCatalogView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/layoutBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutConnectionWarning">

        <!-- Buscador con borde discontinuo -->
        <LinearLayout
            android:id="@+id/layoutSearch"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_search_dashed"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/search_hint"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="sans-serif-condensed"
                android:hint="Buscar en catálogo (tartas, carnes, verduras...)"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btnClearSearch"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/search_hint"
                android:src="@drawable/ic_search"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Filtro Segmentado de Catálogo: Habituales ⭐ | Todos 📋 | Ocultos 👁️ -->
        <LinearLayout
            android:id="@+id/layoutCatalogFilterTabs"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_search_dashed"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/tabFilterFavorites"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_retro"
                android:gravity="center"
                android:text="HABITUALES"
                android:textColor="@color/bg_paper"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabFilterAll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="TODOS"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabFilterHidden"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="OCULTOS"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Filtro Horizontal por Proveedor -->
        <HorizontalScrollView
            android:id="@+id/hsvSupplierFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutSupplierChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp" />
        </HorizontalScrollView>

        <!-- Contenedor Lista o Estado Vacío de Catálogo -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1">

            <!-- Lista de Ingredientes del Catálogo (RecyclerView) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvIngredients"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="12dp"
                tools:listitem="@layout/item_ingredient" />

            <!-- Mensaje Vacío / Error de Catálogo -->
            <TextView
                android:id="@+id/tvEmptyMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:text="@string/empty_catalog"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Indicador de Carga -->
    <ProgressBar
        android:id="@+id/pbLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/stamp_red"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/layoutBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutSectionBar" />

    <!-- ============================================================== -->
    <!-- 3. BARRA INFERIOR ERGONÓMICA TIPO WHATSAPP                      -->
    <!-- ============================================================== -->
    <LinearLayout
        android:id="@+id/layoutBottomNav"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/bg_bottom_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Tab: Mi Pedido / Comanda -->
        <LinearLayout
            android:id="@+id/navItemOrder"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/ivNavOrderIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_order" />

                <!-- Badge Numérico de la Comanda -->
                <TextView
                    android:id="@+id/tvNavOrderBadge"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:layout_marginStart="12dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_camera_fab"
                    android:gravity="center"
                    android:textColor="@color/bg_paper"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="2"
                    tools:visibility="visible" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvNavOrderLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:text="Comanda"
                android:textColor="@color/stamp_red"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab: Catálogo -->
        <LinearLayout
            android:id="@+id/navItemCatalog"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivNavCatalogIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_catalog" />

            <TextView
                android:id="@+id/tvNavCatalogLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:text="Catálogo"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Botón Central: Cámara / Escanear -->
        <LinearLayout
            android:id="@+id/navItemCamera"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_camera_fab"
                android:gravity="center">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_camera" />
            </FrameLayout>
        </LinearLayout>

        <!-- Tab 4: Proveedores -->
        <LinearLayout
            android:id="@+id/navItemSuppliers"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivNavSuppliersIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_suppliers" />

            <TextView
                android:id="@+id/tvNavSuppliersLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:text="Proveedores"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 5: Ajustes -->
        <LinearLayout
            android:id="@+id/navItemSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivNavSettingsIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_settings" />

            <TextView
                android:id="@+id/tvNavSettingsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:text="Ajustes"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
