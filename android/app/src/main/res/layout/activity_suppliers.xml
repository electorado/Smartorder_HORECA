<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_paper"
    android:padding="16dp"
    tools:context=".SuppliersActivity">

    <!-- Cabecera Vintage -->
    <LinearLayout
        android:id="@+id/layoutSuppliersHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_stamp_header"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.06"
            android:text="DIRECTORIO DE PROVEEDORES"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:text="Gestión de contactos y catálogos"
            android:textColor="#F0D0D0"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Botonera de Acciones -->
    <LinearLayout
        android:id="@+id/layoutSupplierActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/layoutSuppliersHeader">

        <Button
            android:id="@+id/btnAddSupplier"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_secondary_retro"
            android:fontFamily="sans-serif-condensed"
            android:text="+ ALTA MANUAL"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnImportContact"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_secondary_retro"
            android:fontFamily="sans-serif-condensed"
            android:text="DE AGENDA 📱"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Lista de Proveedores -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSuppliers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutSupplierActions"
        tools:listitem="@layout/item_supplier" />

    <!-- Barra de Carga -->
    <ProgressBar
        android:id="@+id/pbSuppliersLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/stamp_red"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutSupplierActions" />

</androidx.constraintlayout.widget.ConstraintLayout>

