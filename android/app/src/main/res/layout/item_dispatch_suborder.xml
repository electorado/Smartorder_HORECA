<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_search_dashed"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Fila 1: Nombre + Subtotal + Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSuborderSupplierName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-condensed"
            android:text="Frutas Paco S.L."
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSuborderAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="sans-serif-condensed"
            android:text="42.50 €"
            android:textColor="@color/stamp_red"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivSuborderChannelBadge"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="2dp"
            android:src="@drawable/ic_logo_whatsapp"
            android:contentDescription="Canal" />
    </LinearLayout>

    <!-- Fila 2: Resumen de productos -->
    <TextView
        android:id="@+id/tvSuborderItemsSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-condensed"
        android:maxLines="2"
        android:text="• 5 kg Tomate rama, 2 kg Cebolla"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Fila 3: Botón de acción / Estado -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Estado Completado -->
        <LinearLayout
            android:id="@+id/layoutSuborderSent"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="#E8F5E9"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSuborderSentText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:text="ENVIADO POR SERVIDOR"
                android:textColor="#2E7D32"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Botón para Enviar Pedido (WhatsApp / Email) -->
        <Button
            android:id="@+id/btnSendWhatsAppSuborder"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:backgroundTint="@color/button_retro_bg"
            android:fontFamily="sans-serif-condensed"
            android:text="ENVIAR WHATSAPP"
            app:icon="@drawable/ic_whatsapp"
            app:iconGravity="textStart"
            app:iconTint="@color/bg_paper"
            android:textColor="@color/bg_paper"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="visible" />
    </FrameLayout>
</LinearLayout>
