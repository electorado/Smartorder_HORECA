<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_search_dashed"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Fila 1: Nº Pedido y Estado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvHistoryOrderId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-condensed"
            android:text="PEDIDO #..."
            android:textColor="@color/stamp_red_dark"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHistoryStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_ok"
            android:fontFamily="sans-serif-condensed"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="COMPLETADO"
            android:textColor="@color/button_retro_bg"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Fila 2: Fecha y Total -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvHistoryDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-condensed"
            android:text="Fecha: ..."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvHistoryTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:text="0.00 €"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Fila 3: Resumen de Proveedores y Notas -->
    <TextView
        android:id="@+id/tvHistorySuppliers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif-condensed"
        android:text="Proveedores: ..."
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvHistoryChefNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-condensed"
        android:text="Nota: ..."
        android:textColor="@color/button_accent_orange"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Botón de acción: Reenviar por WhatsApp -->
    <Button
        android:id="@+id/btnReopenWhatsApp"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_btn_secondary_retro"
        android:fontFamily="sans-serif-condensed"
        android:text="Ver / Reenviar por WhatsApp 💬"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Botón Ver Albarán PDF (CU04 / R04F03) -->
    <Button
        android:id="@+id/btnViewOrderPdf"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_btn_secondary_retro"
        android:fontFamily="sans-serif-condensed"
        android:text="📄 Ver Albarán PDF"
        android:textColor="@color/stamp_red_dark"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>

